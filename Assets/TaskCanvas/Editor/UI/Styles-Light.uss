/* TaskCanvas Light Theme - V2.3 */

.task-canvas-root {
    flex-grow: 1;
    background-color: #f5f5f5;
}

.toolbar {
    flex-direction: row;
    align-items: center;
    padding: 8px 12px;
    background-color: #ffffff;
    border-bottom-width: 1px;
    border-bottom-color: #e0e0e0;
    min-height: 40px;
}

.toolbar-title {
    font-size: 16px;
    -unity-font-style: bold;
    color: #333333;
    margin-right: 16px;
}

.toolbar-button {
    background-color: #0078d4;
    color: #ffffff;
    border-radius: 4px;
    padding: 6px 12px;
    margin-left: 8px;
    border-width: 0;
    -unity-font-style: bold;
}

.toolbar-button:hover {
    background-color: #1a88e0;
}

.toolbar-button:active {
    background-color: #006cc1;
}

.theme-toggle {
    background-color: #e8e8e8;
    border-radius: 4px;
    padding: 6px 10px;
    margin-left: 8px;
    border-width: 0;
    color: #333333;
}

.theme-toggle:hover {
    background-color: #d8d8d8;
}

.board-dropdown {
    min-width: 180px;
    margin-left: 8px;
    background-color: #ffffff;
    border-radius: 4px;
    border-width: 1px;
    border-color: #cccccc;
    color: #333333;
}

.filter-bar {
    flex-direction: row;
    align-items: center;
    padding: 8px 12px;
    background-color: #fafafa;
    border-bottom-width: 1px;
    border-bottom-color: #e0e0e0;
    flex-wrap: wrap;
    min-height: 36px;
}

.filter-label {
    color: #666666;
    margin-right: 8px;
    font-size: 12px;
}

.filter-chip {
    background-color: #ffffff;
    border-radius: 12px;
    padding: 4px 10px;
    margin: 2px 4px;
    color: #333333;
    font-size: 11px;
    border-width: 1px;
    border-color: #cccccc;
}

.filter-chip:hover {
    background-color: #f0f0f0;
    border-color: #aaaaaa;
}

.filter-chip.active {
    background-color: #0078d4;
    border-color: #0078d4;
    color: #ffffff;
}

.filter-chip-clear {
    background-color: #fff0f0;
    color: #cc4444;
    border-color: #ffcccc;
}

.filter-chip-clear:hover {
    background-color: #ffe0e0;
}

.filter-chip-more {
    background-color: #f0f0f0;
    color: #666666;
}

.filter-chip-more:hover {
    background-color: #e0e0e0;
    color: #333333;
}

.assignee-chip {
    border-left-width: 3px;
}

.main-scroll-view {
    flex-grow: 1;
}

.columns-container {
    flex-direction: row;
    flex-grow: 1;
    padding: 16px;
    min-height: 100%;
}

.kanban-column {
    width: 280px;
    min-width: 280px;
    background-color: #ffffff;
    border-radius: 8px;
    margin-right: 12px;
    flex-shrink: 0;
    overflow: hidden;
    border-width: 1px;
    border-color: #e0e0e0;
}

.kanban-column.drop-target {
    border-width: 2px;
    border-color: #0078d4;
}

.kanban-column.column-drop-target {
    border-width: 2px;
    border-color: #0078d4;
}

.kanban-column.dragging {
    opacity: 0.7;
}

.column-header {
    padding: 10px 12px;
    flex-direction: row;
    align-items: center;
    cursor: grab;
}

.column-title {
    font-size: 14px;
    -unity-font-style: bold;
    color: #333333;
    flex-grow: 1;
}

.column-title-field {
    font-size: 14px;
    -unity-font-style: bold;
    background-color: #ffffff;
    color: #333333;
    border-radius: 4px;
    border-width: 1px;
    border-color: #0078d4;
    padding: 2px 4px;
    margin: -2px 0;
}

.column-count {
    font-size: 11px;
    color: #666666;
    background-color: #e8e8e8;
    border-radius: 10px;
    padding: 2px 8px;
    margin-right: 8px;
}

.column-edit-button {
    padding: 4px 6px;
    border-radius: 4px;
}

.column-edit-button:hover {
    background-color: #e8e8e8;
}

.edit-button {
    background-color: transparent;
    border-width: 0;
    padding: 4px 6px;
    border-radius: 4px;
    color: #888888;
    font-size: 12px;
}

.edit-button:hover {
    background-color: #e8e8e8;
    color: #333333;
}

.column-cards-scroll {
    flex-grow: 1;
    padding: 8px;
    min-height: 100px;
}

.column-cards {
    flex-grow: 1;
}

.column-add-button {
    margin: 8px;
    margin-bottom: 12px;
    padding: 8px;
    background-color: transparent;
    border-radius: 6px;
    border-width: 0;
    -unity-text-align: middle-center;
    transition: background-color 0.15s ease;
}

.add-column-button {
    width: 200px;
    min-width: 200px;
    height: 60px;
    background-color: #ffffff;
    border-radius: 8px;
    border-width: 2px;
    border-color: #e0e0e0;
    color: #888888;
    font-size: 14px;
    margin-top: 0;
    align-self: flex-start;
}

.add-column-button:hover {
    background-color: #f8f8f8;
    border-color: #0078d4;
    color: #333333;
}

.card-drop-zone {
    height: 4px;
    margin: 2px 0;
    border-radius: 2px;
}

.card-drop-zone.drop-zone-active {
    height: 40px;
    background-color: rgba(0, 120, 212, 0.15);
    border-width: 2px;
    border-color: #0078d4;
}

.kanban-card {
    background-color: #ffffff;
    border-radius: 6px;
    padding: 10px 12px;
    margin-bottom: 4px;
    border-left-width: 4px;
    border-left-color: #0078d4;
    border-width: 1px;
    border-color: #e0e0e0;
}

.kanban-card.card-hover {
    border-color: #0078d4;
}

.kanban-card.dragging {
    opacity: 0.9;
}

.kanban-card.dragging-source {
    opacity: 0.4;
}

.kanban-card.priority-high {
    border-left-color: #e74c3c;
}

.kanban-card.priority-medium {
    border-left-color: #f39c12;
}

.kanban-card.priority-low {
    border-left-color: #27ae60;
}

.card-buttons-container {
    opacity: 0;
    flex-direction: row;
}

.card-action-button {
    padding: 2px 4px;
    margin-left: 4px;
    cursor: link;
    border-radius: 3px;
}

.card-action-button:hover {
    background-color: rgba(0, 0, 0, 0.1);
}

.card-title {
    font-size: 13px;
    color: #333333;
    -unity-font-style: bold;
    white-space: normal;
}

.card-description {
    font-size: 11px;
    color: #666666;
    margin-top: 4px;
    white-space: normal;
}

.card-footer {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    margin-top: 6px;
}

.card-tag {
    background-color: #f0f0f0;
    border-radius: 4px;
    padding: 2px 6px;
    margin-right: 4px;
    margin-bottom: 4px;
    font-size: 10px;
    color: #555555;
}

.card-tag-more {
    background-color: #e0e0e0;
    color: #666666;
}

.card-assignee {
    width: 22px;
    height: 22px;
    border-radius: 11px;
    margin-right: 4px;
    -unity-text-align: middle-center;
    font-size: 10px;
    color: #ffffff;
    -unity-font-style: bold;
    justify-content: center;
    align-items: center;
}

.modal-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(0, 0, 0, 0.3);
    justify-content: center;
    align-items: center;
}

.modal-content {
    background-color: #ffffff;
    border-radius: 8px;
    padding: 20px;
    min-width: 350px;
    max-width: 600px;
    max-height: 80%;
    border-width: 1px;
    border-color: #cccccc;
}

.modal-title {
    font-size: 16px;
    -unity-font-style: bold;
    color: #333333;
    margin-bottom: 16px;
}

.modal-field {
    margin-bottom: 12px;
}

.modal-field-label {
    font-size: 11px;
    color: #666666;
    margin-bottom: 4px;
}

.modal-text-field {
    background-color: #ffffff;
    border-radius: 4px;
    border-width: 1px;
    border-color: #cccccc;
    padding: 8px;
    color: #333333;
}

.modal-text-field:focus {
    border-color: #0078d4;
}

.modal-buttons {
    flex-direction: row;
    justify-content: flex-end;
    margin-top: 16px;
}

.modal-button {
    padding: 8px 16px;
    border-radius: 4px;
    margin-left: 8px;
    border-width: 0;
}

.modal-button-small {
    padding: 2px 8px;
    border-radius: 4px;
    border-width: 0;
    font-size: 10px;
    background-color: #e8e8e8;
    color: #666666;
}

.modal-button-small:hover {
    background-color: #d8d8d8;
    color: #333333;
}

.modal-button-primary {
    background-color: #0078d4;
    color: #ffffff;
}

.modal-button-primary:hover {
    background-color: #1a88e0;
}

.modal-button-secondary {
    background-color: #e8e8e8;
    color: #333333;
}

.modal-button-secondary:hover {
    background-color: #d8d8d8;
}

.modal-button-danger {
    background-color: #fff0f0;
    color: #cc4444;
}

.modal-button-danger:hover {
    background-color: #ffe0e0;
}

.extras-button {
    background-color: #f0f0f0;
    border-radius: 4px;
    border-width: 0;
    padding: 8px;
    margin-bottom: 6px;
    color: #666666;
    -unity-text-align: middle-left;
}

.extras-button:hover {
    background-color: #e8e8e8;
    color: #333333;
}

.extras-button:disabled {
    opacity: 0.5;
}

.empty-state {
    flex-grow: 1;
    justify-content: center;
    align-items: center;
    padding: 40px;
}

.empty-state-text {
    font-size: 14px;
    color: #666666;
    -unity-text-align: middle-center;
    margin-bottom: 16px;
}

.priority-selector {
    flex-direction: row;
    margin-top: 4px;
}

.priority-option {
    padding: 6px 12px;
    margin-right: 4px;
    border-radius: 4px;
    background-color: #f0f0f0;
    color: #666666;
    border-width: 0;
}

.priority-option:hover {
    background-color: #e8e8e8;
}

.priority-option.selected {
    color: #ffffff;
}

.priority-option.priority-low.selected {
    background-color: #27ae60;
}

.priority-option.priority-medium.selected {
    background-color: #f39c12;
}

.priority-option.priority-high.selected {
    background-color: #e74c3c;
}

.drag-placeholder {
    background-color: #d0d0d0;
    border-radius: 6px;
    border-width: 0;
    margin-bottom: 4px;
}

.drag-placeholder-column {
    background-color: #d0d0d0;
    border-radius: 8px;
    border-width: 0;
    min-height: 200px;
}

.kanban-column.dragging-source {
    opacity: 0.4;
}

.check-container {
    height: 20px;
    overflow: hidden;
    flex-shrink: 0;
    justify-content: center;
    align-items: center;
}

.check-label {
    font-size: 16px;
    color: #27ae60;
    -unity-text-align: middle-center;
    width: 20px;
    height: 20px;
}

.card-content {
    flex-grow: 1;
}

.completed-text {
    opacity: 0.5;
}

.kanban-card.completed {
    opacity: 0.8;
}

.completion-check {
    font-size: 14px;
    color: #27ae60;
    margin-right: 6px;
}

.drag-ghost-card {
    opacity: 0.9;
}

.drag-ghost-column {
    opacity: 0.85;
}
